{
  "manifest_version": 3,
  "name": "Bookmark Sync via GitHub",
  "short_name": "Bookmark Sync",
  "version": "0.3.4",
  "description": "通过 GitHub 私人仓库双向同步浏览器收藏夹（单包多浏览器 · 低内存优化版）",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "bookmarks",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "lib/util.js",
      "lib/api.js",
      "lib/config.js",
      "lib/github.js",
      "lib/model.js",
      "lib/sync.js",
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bookmark Sync",
    "default_icon": {
      "16": "icons/icon-16.png",
      "24": "icons/icon-24.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "64": "icons/icon-64.png",
      "128": "icons/icon-128.png"
    },
    "theme_icons": [
      {
        "size": 16,
        "light": "icons/icon-on-dark-16.png",
        "dark": "icons/icon-on-light-16.png"
      },
      {
        "size": 32,
        "light": "icons/icon-on-dark-32.png",
        "dark": "icons/icon-on-light-32.png"
      }
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "strict_min_version": "121.0"
    }
  }
}
