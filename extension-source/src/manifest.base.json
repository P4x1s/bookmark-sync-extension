{
  "manifest_version": 3,
  "name": "Bookmark Sync via GitHub",
  "short_name": "Bookmark Sync",
  "version": "0.3.2",
  "description": "通过 GitHub 私人仓库双向同步浏览器收藏夹（单包多浏览器 · 低内存优化版）",
  "permissions": [
    "bookmarks",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "lib/util.js",
      "lib/api.js",
      "lib/config.js",
      "lib/github.js",
      "lib/model.js",
      "lib/sync.js",
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bookmark Sync"
  },
  "browser_specific_settings": {
    "gecko": {
      "strict_min_version": "121.0"
    }
  }
}
